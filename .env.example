# ===== LLM (OpenAI 兼容接口) =====
# 智谱示例: https://open.bigmodel.cn/api/paas/v4；模型名用 /model 命令设置后自动写入这里
# DeepSeek:  https://api.deepseek.com             模型: deepseek-chat
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=sk-xxx
MODEL=

# ===== 浏览器 =====
# 留空则自动探测常见 Edge 安装路径
EDGE_PATH=
CDP_PORT=9222

# ===== Agent =====
MAX_STEPS=40
