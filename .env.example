# ===== LLM (OpenAI 兼容接口) =====
# 智谱示例: https://open.bigmodel.cn/api/paas/v4  模型: glm-4.6
# DeepSeek:  https://api.deepseek.com             模型: deepseek-chat
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=sk-xxx
MODEL=glm-4.6

# ===== 浏览器 =====
# 留空则自动探测常见 Edge 安装路径
EDGE_PATH=
CDP_PORT=9222

# ===== Agent =====
MAX_STEPS=40
